# Scire environment — copy to .env and fill in your keys.
# Never commit the real .env.

LLM_PROVIDER=openrouter
LLM_MODEL=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OmniRoute: local OpenAI-compatible gateway (http://localhost:20128/v1)
OMNIROUTE_API_KEY=

EMBED_PROVIDER=openai
EMBED_MODEL=
EMBED_API_KEY=
EMBED_DIM=3072

GITHUB_TOKEN=

DATABASE_URL=postgresql+psycopg://scire:scire@localhost:5432/scire
